APP_NAME="TM ANTOINE Advisory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Production (Laravel Cloud) runs at APP_URL=https://portal.tmantoinelaw.com
# with APP_ENV=production and APP_DEBUG=false. SESSION_DOMAIN stays null so the
# session cookie is bound to that host only.

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Disk for uploaded profile photos. Use s3 in production (Laravel Cloud's local
# filesystem is ephemeral); leave as public/local for development.
AVATAR_DISK=public
# Mail is queued, so this needs a worker running: php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
# Laravel Cloud managed cache is TLS-only; leave as tcp for a local Redis.
REDIS_SCHEME=tcp
REDIS_USERNAME=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. Development writes to storage/logs/laravel.log. Production options:
#   microsoft-graph — app-only Graph send as MICROSOFT_GRAPH_MAILBOX (recommended
#                     for Microsoft 365; no SMTP/MFA). Needs Mail.Send application
#                     permission + admin consent + MICROSOFT_GRAPH_TENANT_ID (GUID).
#   smtp            — Microsoft 365 SMTP (often blocked by MFA).
#   resend          — Resend API (requires DNS domain verification).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="TM ANTOINE Advisory"

MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=

# Microsoft Graph app send (when MAIL_MAILER=microsoft-graph)
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_MAILBOX=

RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Social sign-in (Sign in with Google / Microsoft). Without these the buttons
# still render but the redirect answers "<Provider> sign-in is not configured
# yet" — so they must be set on every environment, Laravel Cloud included.
# The callback defaults to APP_URL + /auth/social/<provider>/callback; only set
# the *_REDIRECT_URI vars to override that. Whatever the callback resolves to
# must be registered as an authorised redirect URI with the provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# Opt-in Gmail/Calendar sync scopes. Leave false for plain sign-in only.
GOOGLE_SYNC_ENABLED=false

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# MICROSOFT_REDIRECT_URI=
MICROSOFT_SYNC_ENABLED=false


# Reverb (websockets) — powers live updates on the Messages page.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Smartsheet → CBI sync
SMARTSHEET_ACCESS_TOKEN=
SMARTSHEET_WORKSPACE_ID=
FEATURE_CBI=false
FEATURE_CIP=false

# The firm's own account: who owns files that belong to the firm rather than to
# a person (the SharePoint site libraries, provisioned folders). Falls back to
# the oldest administrator if no account matches, which is what used to file
# every synced document under one partner's name.
PORTAL_SYSTEM_ACCOUNT_EMAIL=portal@tmantoinelaw.com
