/node_modules
# /public/build is COMMITTED on purpose.
#
# The shell lists 107 scripts and 29 stylesheets one by one, because that list
# is the load order. AssetBundle rewrites those tags to the two built files
# when a build exists; with no build it serves the raw tags, which is 135
# requests and 7.1 MB before the dashboard can paint.
#
# `npm run build` only ever ran from `composer setup`, so deploys never built
# one and production served the unbundled shell. esbuild is a devDependency,
# so a build-on-deploy hook would skip silently on any host that installs
# without dev dependencies — and a fix that can silently stop working is how
# this went unnoticed in the first place. Committing it means the bundle is
# always there.
#
# Rebuild with `npm run build` before pushing a change to anything under
# public/js or public/css; AssetBundleTest fails when it is stale.
/public/fonts-manifest.dev.json
/public/hot
/public/storage

# Editor and recovery leftovers. These used to be committed under public/,
# where they were older, unminified copies of shipped JS and CSS sitting in
# the web root: the asset bundler never touches them, so they were served
# raw to anyone who asked. nginx and .htaccess both refuse them now; this
# keeps them from coming back.
*.bak
*.orig
*.rej
/storage/*.key
/storage/app/private/**
!/storage/app/private/.gitignore
/storage/app/public/cip
/storage/framework/testing/disks
/storage/pail
/tmp
/vendor
Homestead.json
Homestead.yaml
Thumbs.db
_ide_helper.php
composer.phar

