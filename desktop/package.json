{
  "name": "tma-portal-desktop",
  "version": "0.8.10",
  "private": true,
  "description": "TM ANTOINE Advisory portal — macOS desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "start:local": "env -u ELECTRON_RUN_AS_NODE TMA_PORTAL_URL=http://localhost:8001 electron .",
    "icon": "./build-icon.sh",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac",
    "release": "env -u ELECTRON_RUN_AS_NODE electron-builder --mac --publish never",
    "release:win": "env -u ELECTRON_RUN_AS_NODE electron-builder --win --x64 --publish never",
    "test": "env -u ELECTRON_RUN_AS_NODE electron test-bridge.js && env -u ELECTRON_RUN_AS_NODE electron test-titlebar.js && env -u ELECTRON_RUN_AS_NODE electron test-update-window.js && env -u ELECTRON_RUN_AS_NODE electron test-notify.js && env -u ELECTRON_RUN_AS_NODE electron test-update-available.js && env -u ELECTRON_RUN_AS_NODE electron test-call-avatar.js",
    "test:update": "env -u ELECTRON_RUN_AS_NODE electron test-update.js",
    "test:call": "env -u ELECTRON_RUN_AS_NODE electron test-call-panel.js",
    "test:notify": "env -u ELECTRON_RUN_AS_NODE electron test-notify.js",
    "test:titlebar": "env -u ELECTRON_RUN_AS_NODE electron test-titlebar.js",
    "test:update-window": "env -u ELECTRON_RUN_AS_NODE electron test-update-window.js",
    "test:update-available": "env -u ELECTRON_RUN_AS_NODE electron test-update-available.js",
    "test:call-avatar": "env -u ELECTRON_RUN_AS_NODE electron test-call-avatar.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tmantoinelaw.portal",
    "productName": "TM ANTOINE Portal",
    "directories": {
      "output": "release"
    },
    "afterPack": "adhoc-sign.js",
    "files": [
      "main.js",
      "preload.js",
      "host-bridge.js",
      "updater.js",
      "window-policy.js",
      "call-window.js",
      "call-window.html",
      "call-preload.js",
      "update-window.js",
      "update-window.html",
      "update-preload.js",
      "settings.js",
      "titlebar.js",
      "tray.js",
      "notifications.js",
      "package.json",
      "assets/tray.png",
      "assets/tray@2x.png",
      "assets/icon.ico",
      "assets/logo-mark.png",
      "update-available.js",
      "update-available.html",
      "update-available-preload.js"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": null,
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Camera access is required for video calls in the portal.",
        "NSMicrophoneUsageDescription": "Microphone access is required for voice and video calls in the portal."
      }
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TM ANTOINE Portal",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "TM ANTOINE Portal"
    },
    "protocols": [
      {
        "name": "TM ANTOINE Portal",
        "schemes": [
          "tmaportal"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://portal.tmantoinelaw.com/desktop/",
        "channel": "latest"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    }
  }
}
