{
  "name": "tma-portal-desktop",
  "version": "0.8.43",
  "private": true,
  "description": "TM ANTOINE Advisory portal, macOS desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "start:local": "env -u ELECTRON_RUN_AS_NODE TMA_PORTAL_URL=http://localhost:8001 electron .",
    "icon": "./build-icon.sh",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac",
    "release": "node bundle-assets.js && env -u ELECTRON_RUN_AS_NODE electron-builder --mac --publish never && node verify-asar.js",
    "release:win": "node bundle-assets.js && env -u ELECTRON_RUN_AS_NODE electron-builder --win --x64 --publish never && node verify-asar.js",
    "test": "env -u ELECTRON_RUN_AS_NODE electron test-file-cache.js && env -u ELECTRON_RUN_AS_NODE electron test-shell-cache.js && env -u ELECTRON_RUN_AS_NODE electron test-offline-boot.js && env -u ELECTRON_RUN_AS_NODE electron test-offline-screen.js && env -u ELECTRON_RUN_AS_NODE electron test-context-menu.js && env -u ELECTRON_RUN_AS_NODE electron test-bridge.js && env -u ELECTRON_RUN_AS_NODE electron test-titlebar.js && env -u ELECTRON_RUN_AS_NODE electron test-update-window.js && env -u ELECTRON_RUN_AS_NODE electron test-notify.js && env -u ELECTRON_RUN_AS_NODE electron test-update-available.js && env -u ELECTRON_RUN_AS_NODE electron test-call-avatar.js && env -u ELECTRON_RUN_AS_NODE electron test-asset-cache.js && env -u ELECTRON_RUN_AS_NODE electron test-deploy-refresh.js && env -u ELECTRON_RUN_AS_NODE electron test-badge.js && env -u ELECTRON_RUN_AS_NODE electron test-taskbar-pin.js && env -u ELECTRON_RUN_AS_NODE electron test-signin-handoff.js && env -u ELECTRON_RUN_AS_NODE electron test-signin-provider.js && env -u ELECTRON_RUN_AS_NODE electron test-update-surface.js && env -u ELECTRON_RUN_AS_NODE electron test-update-prompt.js && env -u ELECTRON_RUN_AS_NODE electron test-splash-colour.js && env -u ELECTRON_RUN_AS_NODE electron test-call-float.js",
    "test:update": "env -u ELECTRON_RUN_AS_NODE electron test-update.js",
    "test:call": "env -u ELECTRON_RUN_AS_NODE electron test-call-panel.js",
    "test:notify": "env -u ELECTRON_RUN_AS_NODE electron test-notify.js",
    "test:titlebar": "env -u ELECTRON_RUN_AS_NODE electron test-titlebar.js",
    "test:update-window": "env -u ELECTRON_RUN_AS_NODE electron test-update-window.js",
    "test:update-available": "env -u ELECTRON_RUN_AS_NODE electron test-update-available.js",
    "test:call-avatar": "env -u ELECTRON_RUN_AS_NODE electron test-call-avatar.js",
    "test:call-float": "env -u ELECTRON_RUN_AS_NODE electron test-call-float.js",
    "assets": "node bundle-assets.js",
    "test:context-menu": "env -u ELECTRON_RUN_AS_NODE electron test-context-menu.js",
    "test:art": "env -u ELECTRON_RUN_AS_NODE electron test-art.js",
    "test:file-cache": "env -u ELECTRON_RUN_AS_NODE electron test-file-cache.js",
    "test:shell-cache": "env -u ELECTRON_RUN_AS_NODE electron test-shell-cache.js",
    "test:navigation": "env -u ELECTRON_RUN_AS_NODE electron test-navigation.js",
    "test:asset-cache": "env -u ELECTRON_RUN_AS_NODE electron test-asset-cache.js",
    "test:deploy-refresh": "env -u ELECTRON_RUN_AS_NODE electron test-deploy-refresh.js",
    "test:badge": "env -u ELECTRON_RUN_AS_NODE electron test-badge.js",
    "test:taskbar-pin": "env -u ELECTRON_RUN_AS_NODE electron test-taskbar-pin.js",
    "test:signin-handoff": "env -u ELECTRON_RUN_AS_NODE electron test-signin-handoff.js",
    "test:signin-provider": "env -u ELECTRON_RUN_AS_NODE electron test-signin-provider.js",
    "test:update-surface": "env -u ELECTRON_RUN_AS_NODE electron test-update-surface.js",
    "test:update-prompt": "env -u ELECTRON_RUN_AS_NODE electron test-update-prompt.js",
    "test:splash-colour": "env -u ELECTRON_RUN_AS_NODE electron test-splash-colour.js",
    "test:offline-boot": "env -u ELECTRON_RUN_AS_NODE electron test-offline-boot.js",
    "test:offline-screen": "env -u ELECTRON_RUN_AS_NODE electron test-offline-screen.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tmantoinelaw.portal",
    "productName": "TM ANTOINE Portal",
    "directories": {
      "output": "release"
    },
    "afterPack": "adhoc-sign.js",
    "files": [
      "main.js",
      "preload.js",
      "host-bridge.js",
      "updater.js",
      "window-policy.js",
      "call-window.js",
      "call-window.html",
      "call-preload.js",
      "update-window.js",
      "update-window.html",
      "update-preload.js",
      "update-surface.js",
      "update-notice.js",
      "settings.js",
      "signin-handoff.js",
      "signin-provider.js",
      "signin-waiting.html",
      "titlebar.js",
      "tray.js",
      "badge.js",
      "taskbar-pin.js",
      "notifications.js",
      "package.json",
      "assets/tray.png",
      "assets/tray@2x.png",
      "assets/icon.ico",
      "assets/logo-mark.png",
      "update-available.js",
      "update-available.html",
      "update-available-preload.js",
      "splash.js",
      "splash.html",
      "assets/logo-full.png",
      "assets/icon-master.png",
      "asset-cache.js",
      "shell-cache.js",
      "file-cache.js",
      "context-menu.js",
      "bundle-assets.js",
      "webassets/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": null,
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Camera access is required for video calls in the portal.",
        "NSMicrophoneUsageDescription": "Microphone access is required for voice and video calls in the portal."
      }
    },
    "dmg": {
      "title": "TM ANTOINE Portal",
      "icon": "assets/icon.icns",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 200,
          "type": "file"
        },
        {
          "x": 390,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TM ANTOINE Portal",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "TM ANTOINE Portal"
    },
    "protocols": [
      {
        "name": "TM ANTOINE Portal",
        "schemes": [
          "tmaportal"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://portal.tmantoinelaw.com/desktop/",
        "channel": "latest"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    }
  }
}
