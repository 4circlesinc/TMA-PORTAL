<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store build only (npm run release:mas). The direct download keeps
  entitlements.mac.plist.

  The store requires the App Sandbox, so everything the app touches outside
  its own container is listed here. The app group and team identifier are
  added at signing time by @electron/osx-sign, from the provisioning profile.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <!-- V8 on Apple silicon maps JIT pages. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- The portal, its websocket, and file downloads. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <!-- Calls. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Office or remote presence. -->
    <key>com.apple.security.personal-information.location</key>
    <true/>
    <!-- Attaching files, and Save As for documents and images. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Downloads land in ~/Downloads when no dialog is shown. -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
    <!-- Printing documents and letters. -->
    <key>com.apple.security.print</key>
    <true/>
</dict>
</plist>
