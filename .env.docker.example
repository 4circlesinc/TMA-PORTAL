# =============================================================================
# TMA-PORTAL — Docker environment
# =============================================================================
#
# Copy to .env.docker to change anything:
#
#     cp .env.docker.example .env.docker
#
# compose.yaml reads this file first and .env.docker second, so .env.docker
# only needs the keys you actually want to override. Both are loaded as real
# process environment variables, and Laravel's env repository is immutable —
# a real environment variable always beats a line in a .env file.
#
# The repository's own .env is NOT used by any container. It points at the
# live Laravel Cloud Postgres, whose `jobs` table is shared with the running
# production deployment: a container inheriting it would not merely read
# production, its workers would pop and execute real jobs — send real mail,
# write to real SharePoint, mutate real client records. compose.yaml mounts an
# empty file over it so that cannot happen by accident.
#
# Every value below is a working local default. Nothing here is a secret.
# =============================================================================


# --- Application -------------------------------------------------------------
APP_NAME="TM ANTOINE Advisory"

# 'local' is load-bearing, not cosmetic: AppServiceProvider keys
# URL::forceScheme('https') on the exact string 'production', and routes/web.php
# gates /design/* behind app()->environment('local').
APP_ENV=local
APP_DEBUG=true

# PUBLIC, DEVELOPMENT-ONLY KEY. It is in version control, so treat anything it
# encrypts as readable by anyone. The entrypoint refuses to start with
# APP_ENV=production while this key is set.
#
# Production supplies its own APP_KEY *and* APP_PREVIOUS_KEYS. Never run
# `artisan key:generate` against a database that has rows in connected_accounts:
# ConnectedAccount.token uses the `encrypted` cast and a new key makes every
# stored Microsoft/Google OAuth token permanently undecryptable.
APP_KEY=base64:Yk5nQ0RlVjBja1hUM3BSNVdmMkxxSmg4dEF6TnhFNmM=
APP_PREVIOUS_KEYS=

# Port 8001 is effectively fixed: the Microsoft app registration's redirect URI
# is http://localhost:8001/auth/social/microsoft/callback, and Google's callback
# is derived from APP_URL. Changing it means re-registering in both consoles.
#
# Use localhost, not 127.0.0.1 — Entra only accepts the literal "localhost" for
# loopback callbacks, and only "localhost" counts as a secure context, which
# getUserMedia / getDisplayMedia / RTCPeerConnection require. On any other
# plain-http origin, calling and screen share fail with no visible error.
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# 'file' writes storage/framework/down inside one container only, so
# `artisan down` would take a single replica offline.
APP_MAINTENANCE_DRIVER=cache
# Without this, the cache-based maintenance driver falls back to the DEFAULT
# cache store rather than the configured one, so every single request pays an
# extra Postgres round trip to ask whether the site is down — while CACHE_STORE
# is redis and answers the same question for free.
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12


# --- Logging -----------------------------------------------------------------
# stderr so `docker compose logs -f` is the one place to look and no log file
# grows inside a container. storage/logs stays writable regardless:
# config/logging.php pins the emergency logger to laravel.log whatever this says.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# LOG_STDERR_FORMATTER is deliberately ABSENT, not set-and-empty.
# config/logging.php reads it with env() and no default, and Laravel only
# applies a formatter when isset() is true. An empty string IS set, so the
# stderr channel fails to build and every log line silently falls back to
# storage/logs/laravel.log — `docker compose logs` goes quiet with no error.



# --- Database ----------------------------------------------------------------
# Set explicitly. config/database.php falls back to 'sqlite', so an unset value
# boots the app silently against an empty SQLite file with no error at all.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tma
DB_USERNAME=tma
DB_PASSWORD=tma

# The container Postgres speaks plain TCP on a private Docker network.
# A managed database (Laravel Cloud, RDS, Neon) needs 'require'.
DB_SSLMODE=disable

# Default is 90 seconds, which is below eight jobs' declared timeouts — the
# longest, SyncSharePointLibrary, runs for up to 1800s. At 90 a second worker
# re-reserves a job that is still running, duplicating Graph and Smartsheet
# calls until the provider throttles.
DB_QUEUE_RETRY_AFTER=1900

# Credentials for the postgres service itself. Must match DB_* above.
POSTGRES_DB=tma
POSTGRES_USER=tma
POSTGRES_PASSWORD=tma


# --- Session -----------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Must stay null. A stale value binds the cookie to a host the container is not
# served on: sign-in appears to succeed, then bounces, with nothing in the log.
SESSION_DOMAIN=null
# Empty over plain http, 'true' behind real TLS. config/session.php has no
# default, so an unset value means the cookie is never marked Secure. Set it in
# production or the session cookie ships in the clear over a public HTTPS site.
SESSION_SECURE_COOKIE=


# --- Cache & Redis -----------------------------------------------------------
# redis, not file. Several job classes use ShouldBeUnique and schedule entries use
# withoutOverlapping(); every one of those locks lives in the cache store. With
# 'file' each container gets its own storage/framework/cache/data, so the
# deduplication silently stops working the moment web and workers are separate
# processes — which is exactly the condition that produced the 4,000-duplicate
# photo-job flood documented in app/Jobs/ResolveSenderPhoto.php.
CACHE_STORE=redis
CACHE_PREFIX=

REDIS_CLIENT=predis
# tcp for a container Redis. Laravel Cloud's managed cache is TLS-only and uses
# 'tls'; against a plain Redis that fails with an opaque stream error.
REDIS_SCHEME=tcp
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_CACHE_DB=1

MEMCACHED_HOST=127.0.0.1


# --- Queue -------------------------------------------------------------------
QUEUE_CONNECTION=database

# config/mail.php defaults this to 'default'. The dedicated photo worker in
# compose.prod.yaml consumes 'mail-photos', so without this it consumes nothing
# while photo jobs keep flooding the queue that mail sync shares.
MAIL_PHOTOS_QUEUE=mail-photos


# --- Broadcasting / Reverb ---------------------------------------------------
# These three are read twice, from two different network vantage points: by the
# server-side Pusher REST client in config/broadcasting.php, and by the browser,
# which receives them from GET /me via App\Support\RealtimeConfig. That is why
# nginx lives inside the app container and proxies /app/ and /apps/ to the
# reverb service — http://localhost:8001 then means the same thing to both.
#
# compose.yaml overrides REVERB_HOST/PORT per service: the worker, scheduler and
# reverb containers never render a page, so they use the internal name directly.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=tma-local
REVERB_APP_KEY=tma-local-key
REVERB_APP_SECRET=tma-local-secret
REVERB_HOST=localhost
REVERB_PORT=8001
REVERB_SCHEME=http

# Reverb's default max_request_size is 10,000 bytes. A WebRTC SDP offer carried
# in CallSignal can exceed that for some codec sets, and call setup then fails
# for those clients only.
REVERB_MAX_REQUEST_SIZE=64000
REVERB_APP_MAX_MESSAGE_SIZE=64000

# The VITE_* keys that .env and .env.example carry are deliberately NOT
# repeated here. Nothing in the codebase reads them (there is no Vite in this
# project), and repeating them was actively harmful:
#
#   NEVER use ${...} in this file.
#
# Compose interpolates env_file values before handing them to the container,
# and it resolves them against the *project's* .env — the production one. So
# `VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"` did not expand to the local key
# five lines above; it expanded to the live Laravel Cloud Reverb key and put it
# in every container's environment, visible to `printenv` and `docker inspect`.
# Masking .env inside the container does not help, because that substitution
# happens on the host before the container exists. Write literal values only.


# --- File storage ------------------------------------------------------------
# Local disks in development, so no S3 credentials are needed and nothing leaves
# the machine. Do not set these to s3 without also setting AWS_DEFAULT_REGION:
# the SDK throws "Missing required client configuration options: region" on the
# first file operation, and 'throw' => false does not catch it. With a region but
# no credentials it is worse — the SDK falls through to the EC2 metadata service
# at 169.254.169.254, which is unroutable here, so every file operation hangs.
FILESYSTEM_DISK=local
AVATAR_DISK=public
FILES_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false


# --- Mail --------------------------------------------------------------------
# 'log' writes every message to the container's stderr, so invitation, password
# reset and signature links are clickable straight out of `docker compose logs`.
#
# Do not set microsoft-graph without a real tenant GUID: AppServiceProvider
# throws from the Mail::extend closure the moment it resolves, and because
# PortalVerifyEmail / PortalResetPassword are deliberately not queued, that
# surfaces as a 500 on registration rather than a failed background job.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="portal@localhost"
MAIL_FROM_NAME="TM ANTOINE Advisory"

MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_MAILBOX=

RESEND_API_KEY=


# --- Social sign-in ----------------------------------------------------------
# Blank is a valid, supported state: the buttons render and the redirect answers
# "<Provider> sign-in is not configured yet" instead of failing. To use them for
# real, register http://localhost:8001/auth/social/<provider>/callback with the
# provider first — the app cannot make a container's URL valid on its own.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Left commented out, not blank: config/services.php falls back to
# APP_URL.'/auth/social/google/callback' only when the key is absent. An empty
# value is a value, and the app would send an empty redirect_uri to Google.
# GOOGLE_REDIRECT_URI=
GOOGLE_SYNC_ENABLED=false

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
# Same as GOOGLE_REDIRECT_URI above — absent, not blank.
# MICROSOFT_REDIRECT_URI=
MICROSOFT_SYNC_ENABLED=false


# --- Feature flags -----------------------------------------------------------
# Off in development: both drive outbound Smartsheet traffic, and SyncSmartsheetSheet
# carries no ->onQueue() so its ~300 nine-minute jobs land on the default queue
# every ten minutes and starve mail sync there.
FEATURE_CBI=false
FEATURE_CIP=false

PORTAL_REQUIRE_MFA=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
FILES_ENVELOPE_ENCRYPT=true
MALWARE_SCANNER=none

SMARTSHEET_ACCESS_TOKEN=
SMARTSHEET_WORKSPACE_ID=


# --- Seeded administrator ----------------------------------------------------
# database/seeders/DatabaseSeeder.php reads these with env() directly, so they
# only resolve while the config cache is cold — which is why `db:seed` must
# never run after `config:cache`. It seeds exactly one approved administrator
# and refuses to invent demo users, clients or content; empty states in a fresh
# development database are correct, not a broken seed.
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=password


# --- Portal ------------------------------------------------------------------
# Owns files that belong to the firm rather than to a person. Falls back to the
# oldest administrator when no account matches.
PORTAL_SYSTEM_ACCOUNT_EMAIL=portal@tmantoinelaw.com


# --- php-fpm pool (app service only) -----------------------------------------
PHP_FPM_MAX_CHILDREN=20
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE=2
PHP_FPM_MAX_SPARE=6

# Xdebug is installed in the dev image but inert. Set to debug to enable.
XDEBUG_MODE=off
